DB_HOST=localhost
DB_PORT=5432
DB_NAME=velvet
DB_USER=velvet
DB_PASSWORD=velvet
REDIS_HOST=localhost
REDIS_PORT=6379
JWT_SECRET=local-dev-secret-change-me-must-be-at-least-32-chars!!
OTP_EXPOSE=true
VELVET_ENV=local
# Production:
# VELVET_ENV=production
# SPRING_PROFILES_ACTIVE=prod
# OTP_EXPOSE=false
LEGAL_DOCUMENT_SET_VERSION=v1-2026-08
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=velvet
S3_SECRET_KEY=velvetsecret
S3_BUCKET=velvet
S3_PUBLIC_BASE=http://localhost:9000
ADMIN_BOOTSTRAP_PHONE=+251911000000
BILLING_PROVIDER=cbe
# mock = offline demo (mock-complete button in app)
# live = real verification via verifier API — recommended in Docker (needs API key below)
# direct = keyless CBE PDF lookup — often blocked from Docker; run API on host to test
CBE_VERIFIER_MODE=mock
CBE_VERIFIER_BASE_URL=https://verifyapi.leulzenebe.pro
CBE_VERIFIER_API_KEY=   # Required for live mode: https://verify.leul.et
CBE_ACCOUNT_NAME=VELVET Ethiopia
CBE_ACCOUNT_NUMBER=1000123456789
CBE_ACCOUNT_SUFFIX=12345678
CBE_BANK_NAME=Commercial Bank of Ethiopia
# Legacy Telebirr (only if BILLING_PROVIDER=telebirr):
TELEBIRR_MODE=mock
TELEBIRR_MOCK_BASE=http://localhost:8080
CONCIERGE_SMS_PHONES=+251911000000
REQUIRE_GEOFENCE=false
SMS_PROVIDER=log
# SMS_PROVIDER=http
# SMS_HTTP_URL=https://your-sms-gateway/send
# SMS_API_KEY=
# SMS_SENDER_ID=VELVET
PUSH_PROVIDER=log
# PUSH_PROVIDER=http
# PUSH_HTTP_URL=https://your-fcm-proxy/send
# Local stand-in: PUSH_HTTP_URL=http://localhost:8080/v1/internal/push/deliver
# PUSH_API_KEY=
RETENTION_LOCATION_DAYS=7
RL_OTP_PER_HOUR=10
RL_CHAT_PER_MINUTE=30
RL_PANIC_PER_HOUR=3
RL_REPORT_PER_HOUR=10
MODERATION_PROVIDER=rule
# Local NLP stub (same API process):
# MODERATION_PROVIDER=http
# MODERATION_HTTP_URL=http://localhost:8080/v1/internal/moderation/score
# MODERATION_API_KEY=
# Production NLP:
# MODERATION_PROVIDER=http
# MODERATION_HTTP_URL=https://your-nlp-moderation/v1/score
# MODERATION_API_KEY=
# TELEBIRR_PUBLIC_KEY_PEM=  # for live notify signature verify
# Live (when onboarded with Ethio Telecom):
# TELEBIRR_MODE=live
# TELEBIRR_FABRIC_APP_ID=
# TELEBIRR_APP_SECRET=
# TELEBIRR_MERCHANT_APP_ID=
# TELEBIRR_MERCHANT_CODE=
# TELEBIRR_PRIVATE_KEY_PEM=
# TELEBIRR_NOTIFY_URL=https://your-api/v1/billing/telebirr/notify
